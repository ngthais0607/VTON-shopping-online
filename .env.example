# Canonical Compose/backend settings for a disposable local demo.
# Compose derives DATABASE_URL and REDIS_URL from the credentials below.
# Database Credentials
MARIADB_ROOT_PASSWORD=your_secure_mariadb_root_password
MARIADB_DATABASE=fastapi_founder
MARIADB_USER=app
MARIADB_PASSWORD=your_secure_app_database_password
REDIS_PASSWORD=your_secure_redis_password

# Application Security
SECRET_KEY=your_minimum_32_characters_secret_key_here

# Storage Credentials
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_secure_minio_password
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your_secure_minio_password
MINIO_BUCKET=product-images
MINIO_SECURE=False

# Payment Webhook
ORDER_EXPIRE_MINUTES=30
VIETQR_BANK_ID=ICB
VIETQR_BANK_NAME=VietinBank
VIETQR_ACCOUNT_NO=0000000000
VIETQR_ACCOUNT_NAME=TRUELOOK
VIETQR_WEBHOOK_SECRET=your_minimum_32_characters_webhook_secret

# Reverse Proxy & Origin
FORWARDED_ALLOW_IPS=127.0.0.1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Build-time opt-in; keep false for self-hosted Docker demo.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
MINIO_EXTERNAL_URL=http://localhost:9000
NEXT_PUBLIC_IMAGE_HOST=http://localhost:9000
CORS_ORIGINS=http://localhost:3000
# Local HTTP development only; production HTTPS must use true.
REFRESH_COOKIE_SECURE=false
APP_ENV=development
# Development-only demo accounts. Existing credentials are never reset.
SEED_ADMIN_PASSWORD=DemoAdmin!482
SEED_CUSTOMER_PASSWORD=DemoCustomer!482
EMAILS_ENABLED=false
EMAILS_CONSOLE_LOG=true
