# Security & JWT
SECRET_KEY=your_random_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=True

# Database & Cache
DATABASE_URL=mysql+pymysql://root:password123@localhost:3307/fastapi_founder
REDIS_URL=redis://localhost:6379/0

# MinIO Object Storage (Required - no default fallback in settings)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET=product-images
MINIO_SECURE=False
MINIO_EXTERNAL_URL=http://localhost:9000

# CORS Origins
CORS_ORIGINS=http://localhost:3000

# VietQR Bank Details Configuration (Replace with your actual bank info)
VIETQR_BANK_ID=YOUR_BANK_ID
VIETQR_BANK_NAME=YOUR_BANK_NAME
VIETQR_ACCOUNT_NO=YOUR_ACCOUNT_NUMBER
VIETQR_ACCOUNT_NAME=TRUELOOK
VIETQR_WEBHOOK_SECRET=your_vietqr_webhook_secret_here

# Email Configuration (ARQ Task Dispatcher)
EMAILS_ENABLED=True
EMAILS_CONSOLE_LOG=True
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_app_password
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME="AI-VTON E-Commerce"
